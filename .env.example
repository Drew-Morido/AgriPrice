# Copy this file to ".env" (already gitignored) in the project root and fill
# in your own value — never commit the real .env file.
#
# Gmail App Password for sending password-reset emails from
# agripriceph@gmail.com. NOT the regular Gmail account password — generate
# one at https://myaccount.google.com/apppasswords (requires 2-Step
# Verification to be turned on first; the App Passwords page only appears
# once it is). See README.txt "Gmail SMTP setup" for the full walkthrough.
AGRIPRICE_GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Google sign-in ("Continue with Google") for public user accounts. Create an OAuth client
# (type: Web application) at https://console.cloud.google.com -> APIs & Services -> Credentials,
# with Authorized JavaScript origins http://localhost:5000 and http://127.0.0.1:5000, and paste
# its Client ID here. Only the Client ID is used; do NOT put the client secret in this project.
AGRIPRICE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Only when the app runs behind a reverse proxy that sets X-Forwarded-For itself: lets the login
# lockout use the real visitor address. Leave unset otherwise (a visitor could fake the header).
# AGRIPRICE_TRUST_PROXY=1
