# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Timestamped model backups
model/_backup_*/

# Public/vendor user accounts (real emails + password hashes from actual use —
# unlike the committed market-data DB in datasets/, this is runtime-generated PII)
model/agriprice_users.db
# ...and any backup copy of it (same password hashes and emails)
model/agriprice_users.db.*

# Secrets (Gmail SMTP app password, etc.) — see .env.example
.env
# A dot-less copy is not read by the app, but would otherwise be committed (`env/` above only
# matches a folder).
/env

# Logs
*.log

# OS / editor junk
Thumbs.db
.DS_Store
*.swp

# Scraper debug artifacts
tools/debug_fetch/*.pdf

# Downloaded source files kept under datasets/3_source_files (re-downloadable, ~2 GB of PDFs; see datasets/README.md).
# The manifest of the DA daily bulletins stays tracked so the archive can be rebuilt with fetch_da_bulletins.py.
datasets/3_source_files/DA-AMAS/daily_bulletins_pdf/**/*.pdf
datasets/3_source_files/DA-AMAS/daily_price_index_pdf/
datasets/3_source_files/DA-AMAS/scraper_downloads/
datasets/3_source_files/DOE/weekly_pdf/
datasets/3_source_files/World_Bank/*.xlsx

# Last built forecast payload (runtime cache, rebuilt automatically — model/predict.py)
model/forecast_cache.json
model/forecast_cache.json.tmp

